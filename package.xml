<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mecanumbot_sensorprocess_smart</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="csengehubay@gmail.com">temesi</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>mecanumbot_msgs</exec_depend>
  <!-- ROS4HRI (REP-155) message set, used by the camera detectors -->
  <exec_depend>hri_msgs</exec_depend>
  <!-- Bounding boxes out of the fetch detector, and the located ball -->
  <exec_depend>vision_msgs</exec_depend>
  <!-- perception.launch.py starts the compressed camera publisher when the
       detector is not to own the camera itself. Nothing here imports it. -->
  <exec_depend>mecanumbot_camera_stream</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
